# HuggingFace token (required)
HF_TOKEN=hf_your_token_here

# Optional: fixed API key. Secret — keep it here in the gitignored .env, never in
# docker-compose.yml. If left empty, the entrypoint generates and persists
# sk-<uuid> in the vllm-keys volume.
#VLLM_API_KEY=sk-your_fixed_key_here

# Reverse proxy (optional — required for HTTPS/DuckDNS)
# See README.md for setup instructions
LETSENCRYPT_DOMAIN=your-domain.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# NVIDIA variant: NVFP4 quantization via NVIDIA ModelOpt format.
MODEL_NAME=nvidia/Qwen3.8-27B-NVFP4
QUANTIZATION=modelopt_mixed
HF_CACHE_VOLUME=hf-cache-nvidia
MAX_MODEL_LEN=131072
SERVED_MODEL_NAME=vllm/nvidia/qwen3.8-27b-nvfp4

# Unsloth variant: NVFP4 quantization via Hugging Face compressed-tensors format.
# (also the entrypoint default when .env is absent)
#MODEL_NAME=unsloth/Qwen3.8-27B-NVFP4
#QUANTIZATION=compressed-tensors
#HF_CACHE_VOLUME=hf-cache-unsloth
#MAX_MODEL_LEN=116800
