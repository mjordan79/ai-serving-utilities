# HuggingFace token (required)
HF_TOKEN=hf_your_token_here

# Optional: fixed API key. Secret — keep it here in the gitignored .env, never in
# docker-compose.yml. If left empty, the entrypoint generates and persists
# sk-<uuid> in the sglang-keys volume.
#VLLM_API_KEY=sk-your_fixed_key_here

# Reverse proxy (optional — required for HTTPS/DuckDNS)
# See README.md for setup instructions
LETSENCRYPT_DOMAIN=your-domain.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# Model (SGLang)
MODEL_NAME=gittensor-model-hub/Qwen3.8-27B-NVFP4-RTX5090
HF_CACHE_VOLUME=hf-cache-gittensor

# Optional: vision tower is OFF by default (--json-model-override-args
# {"language_model_only": true}: encoder weights never loaded, VRAM freed
# for KV cache, multimodal requests rejected). To serve images, set in
# .env: JSON_MODEL_OVERRIDE_ARGS={} (or any custom JSON override string).
#JSON_MODEL_OVERRIDE_ARGS={}
