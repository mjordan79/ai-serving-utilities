# HuggingFace token (required)
HF_TOKEN=hf_your_token_here

# Reverse proxy (optional — required for HTTPS/DuckDNS)
# See README.md for setup instructions
LETSENCRYPT_DOMAIN=my-domain.duckdns.org
LETSENCRYPT_EMAIL=you@example.com

# NVIDIA variant: NVFP4 quantization via NVIDIA ModelOpt format.
MODEL_NAME=nvidia/Qwen3.6-27B-NVFP4
QUANTIZATION=modelopt
HF_CACHE_VOLUME=hf-cache-nvidia
MAX_MODEL_LEN=131072

# Unsloth variant: NVFP4 quantization via Hugging Face compressed-tensors format.
#MODEL_NAME=unsloth/Qwen3.6-27B-NVFP4
#QUANTIZATION=compressed-tensors
#HF_CACHE_VOLUME=hf-cache-unsloth
#MAX_MODEL_LEN=116800
